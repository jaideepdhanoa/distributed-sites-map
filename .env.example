# JSON list: [{"u":"jaideep","h":"<bcrypt cost 12>","role":"admin"}]
AUTH_USERS=
# Long random string. Changing it signs everyone out.
AUTH_SECRET=

# Upstash Redis from the Vercel Marketplace integration. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Neon pooled connection string. Leave unset to run the map read-only.
# DATABASE_URL=
# DATABASE_SSL=disable
# Map existing account roles to queue access. Keys are role labels, not account names.
# {"admin":"reviewer","user":"contributor"}
# ACTION_ROLE_MAP=

# Optional mailbox on an AUTH_USERS object: "email":"cindel.pena@moove.io"
# Override without editing the password hash. Username to mailbox.
# {"cindel":"cindel.pena@moove.io","jaideep":"jaideep@dhanoa.in"}
# ALERT_EMAILS=

# Resend is the sender. The domain is distributedsites.com, and its DNS is in Vercel DNS.
# Leave both transports unset to record would-send rows.
# RESEND_API_KEY=
# ALERT_FROM=Distributed Sites <alerts@distributedsites.com>
# Host for links in alert mail. Defaults to https://distributedsites.com.
# APP_URL=https://distributedsites.com
# Optional. Defaults to jaideep@dhanoa.in.
# ALERT_REPLY_TO=jaideep@dhanoa.in
# Optional Gmail fallback, used only when RESEND_API_KEY is unset.
# SMTP_USER=jaideep@dhanoa.in
# SMTP_PASS=
# Long random string. Vercel Cron sends it as a bearer token.
# CRON_SECRET=
