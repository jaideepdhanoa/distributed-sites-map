{
  "name": "sites-map",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build-data": "python3 scripts/build_data.py",
    "validate-data": "python3 scripts/build_data.py --check",
    "hash-password": "node scripts/hash-password.mjs",
    "add-user": "node scripts/hash-password.mjs --user",
    "test": "node --import tsx --test tests/actions/*.test.ts tests/alerts/*.test.ts tests/cstore.test.ts tests/review.test.ts tests/photos.test.ts tests/financials.test.ts tests/login.test.ts",
    "test:e2e": "playwright test",
    "test:actions": "E2E_ACTIONS=1 playwright test e2e/actions.spec.ts e2e/queue.spec.ts",
    "test:timeline": "python3 -m unittest tests/timeline/test_timeline.py tests/timeline/test_site_id.py && node --experimental-strip-types --test tests/timeline/filter.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "reconcile-suggestions": "tsx scripts/reconcile-suggestions.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.68.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.5",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
