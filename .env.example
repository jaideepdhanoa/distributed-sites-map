# JSON list: [{"u":"jaideep","h":"<bcrypt cost 12>","role":"admin"}]
AUTH_USERS=
# Long random string. Changing it signs everyone out.
AUTH_SECRET=

# Upstash Redis from the Vercel Marketplace integration. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Neon pooled connection string. Leave unset to run the map read-only.
# DATABASE_URL=
# DATABASE_SSL=disable
# Map existing account roles to queue access. Keys are role labels, not account names.
# {"admin":"reviewer","user":"viewer"}
# ACTION_ROLE_MAP=
